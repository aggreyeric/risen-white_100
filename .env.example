# Copy this file to `.env.local` to enable the development-only mock wallet.
#
# VITE_MOCK_WALLET=true
#   Stands in for the Freighter extension (which cannot run in headless browsers).
#   The mock auto-creates a throwaway Testnet account funded by Friendbot, so
#   balances and transactions are REAL on Testnet. Leave unset for production /
#   to use the real Freighter extension.
#
# VITE_MOCK_WALLET=true
